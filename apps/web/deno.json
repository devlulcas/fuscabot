{
  "imports": {
    "@fuscabot/api": "../api/mod.ts",
    "@fuscabot/contracts": "../../packages/contracts/mod.ts"
  },
  "tasks": {
    "sync": "deno run -A npm:@sveltejs/kit@2.70.2/svelte-kit sync",
    "dev": "deno run -A npm:vite@8.2.0 dev",
    "build": "deno run -A npm:vite@8.2.0 build",
    "preview": "deno run -A npm:vite@8.2.0 preview",
    "start": "deno run -A .deno-deploy/server.ts",
    "check": "deno task sync && deno run -A npm:svelte-check@4.7.4 --tsconfig ./tsconfig.json",
    "test": "deno task test:unit",
    "test:unit": "deno run -A npm:vitest@4.1.0 run",
    "test:e2e": "deno run -A npm:playwright@1.62.1 test"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [".svelte-kit/", ".deno-deploy/", "playwright-report/", "test-results/"]
  },
  "lint": {
    "exclude": [
      ".svelte-kit/",
      ".deno-deploy/",
      "src/routes/",
      "playwright-report/",
      "test-results/"
    ],
    "rules": { "tags": ["recommended"] }
  },
  "exclude": [".svelte-kit/", ".deno-deploy/", "playwright-report/", "test-results/"]
}
